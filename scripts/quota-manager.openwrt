#!/bin/sh /etc/rc.common
# /etc/init.d/quota-manager — OpenWrt procd service script for Netrex
# (the on-disk app dir /opt/quota-manager is deliberately unchanged).
#
# Easiest: sh scripts/install_openwrt.sh   (does all of this, apk or opkg)
# Manual install:
#   cp scripts/quota-manager.openwrt /etc/init.d/quota-manager
#   chmod +x /etc/init.d/quota-manager
#   /etc/init.d/quota-manager enable
#   /etc/init.d/quota-manager start

USE_PROCD=1
START=95
STOP=10

PROG="/usr/bin/python3"
APP_DIR="/opt/quota-manager"
CONF="/etc/quota-gateway/config.yaml"

start_service() {
    [ -f "$APP_DIR/run.py" ] || {
        echo "Netrex not found at $APP_DIR (run scripts/install_openwrt.sh)" >&2
        return 1
    }
    [ -f "$CONF" ] || {
        echo "No config at $CONF (run scripts/install_openwrt.sh)" >&2
        return 1
    }

    procd_open_instance
    procd_set_param command "$PROG" "$APP_DIR/run.py" --config "$CONF"
    # router deps live beside the code, installed by pip --target
    procd_set_param env PYTHONPATH="$APP_DIR/pylib"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
